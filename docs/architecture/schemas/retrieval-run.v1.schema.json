{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Knowledge OS evidence retrieval run V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "corpus_digest",
    "annotation_digest",
    "profile_digest",
    "implementation_id",
    "results"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "corpus_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "annotation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "request",
          "status",
          "items"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query_text",
              "subject_id",
              "policy_snapshot_digest",
              "publication_snapshot_digest"
            ],
            "properties": {
              "query_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              },
              "subject_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "policy_snapshot_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "publication_snapshot_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "timeout"
            ]
          },
          "items": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "fragments"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "fragments": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "document_id",
                      "revision_id",
                      "block_id",
                      "start",
                      "end"
                    ],
                    "properties": {
                      "document_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "revision_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "block_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
