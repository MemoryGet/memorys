{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Knowledge OS evidence retrieval dataset V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "corpus_digest",
    "annotation_digest",
    "cases"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "corpus_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "annotation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "kind",
          "request",
          "allowed",
          "relevant"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "answerable",
              "unanswerable",
              "denied",
              "withdrawn"
            ]
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query_text",
              "subject_id",
              "policy_snapshot_digest",
              "publication_snapshot_digest"
            ],
            "properties": {
              "query_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              },
              "subject_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "policy_snapshot_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "publication_snapshot_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "allowed": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_id",
                "revision_id",
                "block_id",
                "start",
                "end"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "revision_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "block_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              }
            }
          },
          "relevant": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_id",
                "revision_id",
                "block_id",
                "start",
                "end"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "revision_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "block_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              }
            }
          }
        }
      }
    }
  }
}
