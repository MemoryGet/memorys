{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Knowledge OS UploadOperation V1",
  "description": "Internal record only: claims are not proof of current authorization, durable bytes or committed transaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "operation_id",
    "space_id",
    "subject_id",
    "idempotency_key",
    "semantic_digest",
    "profile_digest",
    "target",
    "content",
    "state",
    "row_version",
    "fencing_high_water",
    "retention_hold_id",
    "audit_reference",
    "cancel_requested",
    "attempt",
    "candidate",
    "unknown_result",
    "result",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "upload_operation"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "maxLength": 200
    },
    "space_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "maxLength": 200
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "kb_id"
          ],
          "properties": {
            "kind": {
              "const": "create_draft"
            },
            "kb_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "kb_id",
            "draft_id",
            "expected_row_version"
          ],
          "properties": {
            "kind": {
              "const": "replace_original"
            },
            "kb_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "draft_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "expected_row_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size",
        "media_type"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "state": {
      "enum": [
        "accepted",
        "receiving",
        "validated",
        "materializing",
        "prepared",
        "reconciling",
        "committed",
        "rejected"
      ]
    },
    "row_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "fencing_high_water": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "retention_hold_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "maxLength": 200
    },
    "audit_reference": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "maxLength": 200
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "attempt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt_id",
            "fencing_token",
            "lease_owner_id",
            "lease_until_seconds"
          ],
          "properties": {
            "attempt_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "fencing_token": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "lease_owner_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "lease_until_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt_id",
            "blob_id",
            "storage_binding_ref",
            "storage_epoch_id",
            "object_version_ref",
            "content"
          ],
          "properties": {
            "attempt_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "blob_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "storage_binding_ref": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "storage_epoch_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "object_version_ref": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "content": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "size",
                "media_type"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "media_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "unknown_result": {
      "enum": [
        null,
        "object_write",
        "metadata_commit"
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blob_id",
            "draft_id",
            "draft_row_version",
            "job_id",
            "transaction_id",
            "journal_cursor"
          ],
          "properties": {
            "blob_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "draft_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "draft_row_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "job_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "transaction_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
              "maxLength": 200
            },
            "journal_cursor": {
              "type": "string",
              "pattern": "^j1:[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "enum": [
                "ACCESS_DENIED",
                "CONFLICT",
                "CANCELLED",
                "INVALID_INPUT",
                "INTEGRITY_FAILED",
                "DEADLINE_EXCEEDED",
                "INTERNAL"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
