{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Knowledge OS controlled build lock V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lock_id", "deployment_sha256", "retention_policy", "releases"],
  "properties": {
    "schema_version": {"const": 1},
    "lock_id": {"$ref": "#/$defs/id"},
    "deployment_sha256": {"$ref": "#/$defs/digest"},
    "retention_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_version", "file_sha256"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/id"},
        "policy_version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "file_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "releases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["provider", "implementation_version", "lifecycle_contract", "manifest_sha256", "artifact_sha256", "source"],
        "properties": {
          "provider": {"$ref": "#/$defs/id"},
          "implementation_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "lifecycle_contract": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)$"},
          "manifest_sha256": {"$ref": "#/$defs/digest"},
          "artifact_sha256": {"$ref": "#/$defs/digest"},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["repository", "revision"],
            "properties": {
              "repository": {"type": "string", "minLength": 1, "maxLength": 500},
              "revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 100, "pattern": "^[a-z][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
