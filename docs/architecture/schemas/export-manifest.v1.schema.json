{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Knowledge OS full metadata snapshot ExportManifest V1",
  "description": "Manifest and record-envelope design only. Foreign keys, payload contracts, actual committed snapshot and import transactions require additional verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "kind",
    "source",
    "snapshot",
    "segments",
    "blob_payloads",
    "derived_indexes",
    "lease_restore"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "export_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "kind": {
      "const": "metadata_full_snapshot"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "build_lock_sha256",
        "metadata_contract_version"
      ],
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "build_lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata_contract_version": {
          "const": "1.1"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "journal_stream_id",
        "committed_watermark",
        "boundary",
        "writes"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "journal_stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "committed_watermark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "boundary": {
          "const": "after_complete_transaction"
        },
        "writes": {
          "const": "all_metadata_writes_paused"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 53,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "resource_type",
          "record_contract",
          "encoding",
          "record_count",
          "byte_length",
          "sha256"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "resource_type": {
            "enum": [
              "space",
              "knowledge_base",
              "principal",
              "identity_binding",
              "membership",
              "kb_grant",
              "authorization_policy",
              "document",
              "draft",
              "draft_block",
              "draft_blob",
              "revision",
              "block",
              "blob",
              "storage_binding",
              "revision_blob",
              "approval_request",
              "approval",
              "publication_operation",
              "publication_history",
              "backend_epoch",
              "generation_set",
              "index_generation",
              "backend_binding",
              "profile_snapshot",
              "job",
              "job_attempt",
              "outbox",
              "consumer_receipt",
              "idempotency_record",
              "audit_record",
              "migration_journal",
              "feedback",
              "draft_proposal",
              "memory_record",
              "retention_hold",
              "purge_job",
              "migration_operation",
              "tombstone",
              "request_record",
              "invocation_record",
              "immutable_payload",
              "credential_reference",
              "retention_policy_snapshot",
              "upload_operation",
              "trust_domain",
              "trust_head",
              "trust_snapshot",
              "key_retirement",
              "trust_activation",
              "runtime_trust_receipt",
              "deployment_audit_record",
              "deployment_outbox_record"
            ]
          },
          "record_contract": {
            "type": "string",
            "pattern": "^akos\\.metadata\\.[a-z_]+/1$"
          },
          "encoding": {
            "const": "jsonl-envelope/1"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "blob_payloads": {
      "const": "external_required_before_cutover"
    },
    "derived_indexes": {
      "const": "excluded_rebuild_or_verify"
    },
    "lease_restore": {
      "const": "invalidate_all_inflight"
    }
  }
}
