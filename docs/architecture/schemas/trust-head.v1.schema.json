{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "akos.metadata.trust_head/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_id",
    "issuer_id",
    "active",
    "build_lock_digest",
    "high_water_version",
    "row_version"
  ],
  "properties": {
    "domain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "build_lock_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "high_water_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "row_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  }
}
