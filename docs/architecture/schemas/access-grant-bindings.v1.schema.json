{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal access grant bindings V1",
  "description": "Shape of a trusted verifier result, not proof of signature or authorization. Cannot be supplied as an HTTP body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "issuer_id",
    "audience_module_id",
    "caller_service_id",
    "subject_id",
    "action",
    "method",
    "path",
    "invocation_id",
    "request_digest",
    "scope_digest",
    "profile_digest",
    "issued_at_ns",
    "not_before_ns",
    "expires_at_ns"
  ],
  "properties": {
    "format": {
      "const": "akos.grant-bindings/1"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "audience_module_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "caller_service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "method": {
      "enum": [
        "POST",
        "PUT",
        "GET",
        "DELETE"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^/modules/v1/[a-z_]+/[a-z_]+$",
      "maxLength": 200
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issued_at_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "not_before_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "expires_at_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  }
}
