{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Knowledge OS public key snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "version",
    "issuer_id",
    "valid_from_ns",
    "valid_until_ns",
    "max_lifetime_ns",
    "keys"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "valid_from_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "valid_until_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "max_lifetime_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "algorithm",
          "public_key",
          "enabled_at_ns",
          "sign_until_ns",
          "verify_until_ns"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "algorithm": {
            "const": "EdDSA"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          },
          "enabled_at_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "sign_until_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "verify_until_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      }
    }
  }
}
